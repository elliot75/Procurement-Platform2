# ============================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================
VITE_API_BASE_URL=http://localhost:3000

# ============================================
# BACKEND ENVIRONMENT VARIABLES
# ============================================

# Database Connection
# Format: postgresql://username:password@host:port/database
DATABASE_CONNECTION_STRING=postgresql://username:password@localhost:5432/procurement_db

# JWT Secret (Change this in production!)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# API Base URL
API_BASE_URL=http://localhost:3000

# Application URL (for email links)
APP_URL=http://localhost:5173

# ============================================
# EMAIL SERVICE CONFIGURATION (SMTP)
# ============================================

# SMTP Server Settings
SMTP_HOST=mail.example.com
SMTP_PORT=25
SMTP_USER=noreply@example.com
SMTP_PASS=your_smtp_password

# Email From Address
SMTP_FROM=noreply@example.com
ADMIN_EMAIL=admin@example.com

# ============================================
# ADMIN SEED (used by npm run db:setup)
# ============================================
DEFAULT_ADMIN_USERNAME=upvn
DEFAULT_ADMIN_PASSWORD=change_me_strong_admin_password

# Database TLS (set DB_SSL_REJECT_UNAUTHORIZED=false only if required)
# DATABASE_SSL=disable
# DB_SSL_REJECT_UNAUTHORIZED=true

# SMTP TLS
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# ============================================
# OPTIONAL SETTINGS
# ============================================

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development
